# Frontend (exposed to the browser — publishable values only)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Public VAPID key for Web Push (Phase 5). The private key lives only in Supabase secrets.
VITE_VAPID_PUBLIC_KEY=

# Edge Function secrets (set with `supabase secrets set`, never in the frontend):
#   VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT=mailto:you@example.com
#   CRON_SECRET (shared secret that pg_cron sends to the send-reminders function)
